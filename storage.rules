rules_version = '2';
// Only used if you switch uploads from the FastAPI/Emergent object storage bridge to Firebase Storage.
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
